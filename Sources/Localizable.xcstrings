{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 正在运行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行"
          }
        }
      }
    },
    "%@（已自定义）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Customized)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已自定义）"
          }
        }
      }
    },
    "MouseTuner 需要保持运行：鼠标重新连接或电脑唤醒后，它会自动重新套用设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep MouseTuner running so it can reapply your settings when a mouse reconnects or your Mac wakes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MouseTuner 需要保持运行：鼠标重新连接或电脑唤醒后，它会自动重新套用设置。"
          }
        }
      }
    },
    "前往授权": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往授权"
          }
        }
      }
    },
    "反转垂直滚动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverse vertical scrolling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反转垂直滚动"
          }
        }
      }
    },
    "反转水平滚动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverse horizontal scrolling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反转水平滚动"
          }
        }
      }
    },
    "只有「反转滚动方向」需要「%@」权限，调节速度不需要。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only reversing the scroll direction needs %@ permission. Adjusting speed doesn't."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有「反转滚动方向」需要「%@」权限，调节速度不需要。"
          }
        }
      }
    },
    "它会修改同样的鼠标参数，可能覆盖这里的设置。建议先退出它。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changes the same mouse settings and may override the ones here. Quit it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会修改同样的鼠标参数，可能覆盖这里的设置。建议先退出它。"
          }
        }
      }
    },
    "已授权": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权"
          }
        }
      }
    },
    "已连接的鼠标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected Mice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接的鼠标"
          }
        }
      }
    },
    "快": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快"
          }
        }
      }
    },
    "恢复默认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Defaults"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认"
          }
        }
      }
    },
    "慢": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢"
          }
        }
      }
    },
    "打开 MouseTuner…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open MouseTuner…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 MouseTuner…"
          }
        }
      }
    },
    "打开系统设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "技术支持": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技术支持"
          }
        }
      }
    },
    "授权后立即生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect as soon as you allow it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权后立即生效。"
          }
        }
      }
    },
    "未检测到鼠标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mouse Detected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到鼠标"
          }
        }
      }
    },
    "未知鼠标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown Mouse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知鼠标"
          }
        }
      }
    },
    "未连接鼠标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No mouse connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接鼠标"
          }
        }
      }
    },
    "滚动速度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动速度"
          }
        }
      }
    },
    "版本 %@ · 退出后，调整过的鼠标会恢复为系统默认设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ · When you quit, adjusted mice go back to system defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@ · 退出后，调整过的鼠标会恢复为系统默认设置。"
          }
        }
      }
    },
    "登录时自动启动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动"
          }
        }
      }
    },
    "立即重新启动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重新启动"
          }
        }
      }
    },
    "设备控制和数据访问": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device Control and Data Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备控制和数据访问"
          }
        }
      }
    },
    "语言": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "跟随系统": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "辅助功能": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "这只鼠标不使用自然滚动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mouse won't use natural scrolling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只鼠标不使用自然滚动"
          }
        }
      }
    },
    "这只鼠标使用自然滚动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mouse will use natural scrolling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只鼠标使用自然滚动"
          }
        }
      }
    },
    "连接鼠标后会自动显示在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected mice show up here automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接鼠标后会自动显示在这里。"
          }
        }
      }
    },
    "追踪速度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪速度"
          }
        }
      }
    },
    "退出 MouseTuner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit MouseTuner"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 MouseTuner"
          }
        }
      }
    },
    "适用于侧边滚轮或横向滚动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For side wheels and horizontal scrolling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于侧边滚轮或横向滚动"
          }
        }
      }
    },
    "通用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "重新启动 MouseTuner 后生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect after MouseTuner restarts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 MouseTuner 后生效。"
          }
        }
      }
    },
    "重新连接后，之前的设置会自动恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings come back automatically when it reconnects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接后，之前的设置会自动恢复。"
          }
        }
      }
    },
    "隐私政策": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私政策"
          }
        }
      }
    },
    "需要「%@」权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ permission required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「%@」权限"
          }
        }
      }
    },
    "鼠标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标"
          }
        }
      }
    },
    "鼠标已断开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Disconnected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标已断开"
          }
        }
      }
    }
  },
  "version": "1.0"
}